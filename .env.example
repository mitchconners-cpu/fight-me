# --- Required ---
# Secret salt used to hash phone numbers and BTC addresses into anonymous
# tokens. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit the real value or reuse it across environments.
PROJECT_CRYPTO_SALT=

# --- Twilio (required for signature validation on the SMS webhook) ---
# From your Twilio console. If left blank, inbound webhook signature
# validation is DISABLED and a warning is printed on every request --
# fine for local dev, not fine for anything internet-facing.
TWILIO_AUTH_TOKEN=

# --- Local SMS gateway (used instead of/alongside Twilio) ---
# Where outbound replies get POSTed if you're using local_twilio.py or an
# Android SMS-gateway app instead of/in addition to Twilio.
ANDROID_GATEWAY_URL=http://127.0.0.1:8081/send

# --- Wallet addresses ---
# Shared escrow address where matched wager funds are expected to land.
COMPANY_BTC_ESCROW_ADDRESS=

# Address where the platform entry/login fee is collected.
COMPANY_BTC_FEE_ADDRESS=

# --- Fees & pricing ---
# Entry fee required before a user can create/join wagers, in satoshis.
LOGIN_FEE_SATS=1000

# --- Local AI fallback (optional) ---
# Ollama endpoint used for the catch-all SMS assistant reply when a message
# doesn't match a known command. Safe to leave default if running Ollama
# locally on its default port.
OLLAMA_API_URL=http://localhost:11434/api/generate
